{
  "name": "boutique-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Tanvi Agnihotry boutique API — Hono app layer + Postgres data layer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "parse:photo": "tsx --env-file-if-exists=.env scripts/parse-photo.ts",
    "backfill:photo-colors": "tsx --env-file-if-exists=.env scripts/backfill-photo-colors.ts",
    "backfill:image-renditions": "tsx --env-file-if-exists=.env scripts/backfill-image-renditions.ts",
    "prune:events": "tsx --env-file-if-exists=.env scripts/prune-events.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "bcryptjs": "^3.0.2",
    "hono": "^4.6.14",
    "jose": "^5.10.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
