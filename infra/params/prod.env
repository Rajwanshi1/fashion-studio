ENV_NAME=prod
PRIMARY_REGION=ap-south-1
WAF_REGION=us-east-1
APP_INSTANCE_TYPE=t3.medium
DATA_INSTANCE_TYPE=t3.medium
APP_MIN=2
APP_MAX=6
ECR_REPO_NAME=fashion-prod-api
NAT_MODE=gateway
DETAILED_MONITORING=true
PAYMENT_PROVIDER=disabled
ALLOW_MOCK_PAYMENTS=false
SMS_PROVIDER=disabled
ALLOW_CONSOLE_OTP=false
SEED_DEMO_CUSTOMER=false
ANTHROPIC_MODEL=claude-sonnet-5
DOMAIN_NAME=tanviagnihotry.com
# Media CDN + alerts (docs/media-cdn-runbook.md). Keep in sync with what the
# executed changesets set — an out-of-sync `stacks` run would revert them.
ALERT_EMAIL=sarthak.rajwanshi@gmail.com
KEEP_LEGACY_PUBLIC_READ=true
